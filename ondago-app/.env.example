# Copy to .env and adjust. Only EXPO_PUBLIC_* vars are visible to the app —
# never put secrets here; they'd be bundled into the client.

# Explicit API base URL (highest priority). Leave unset to use the defaults
# in src/config.ts (local backend on port 5147).
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5147

# Set to "true" to target the deployed Azure backend instead of localhost.
EXPO_PUBLIC_USE_PROD=false
