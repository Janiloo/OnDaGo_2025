<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnDaGO.MAUI.Views.CreatePUVPage"
             Title="Create PUV Account"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">
        <!-- Background Gradient -->
        <Image Grid.RowSpan="2" Aspect="AspectFill" Source="gradient.png"/>

        <!-- Logo -->
        <Image 
            Grid.Row="0"
            Source="ondagologonobg.png" 
            HorizontalOptions="Center"
            HeightRequest="210"
            WidthRequest="260"/>

        <!-- Bottom Sheet for Admin Creation Form -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Margin="0, -40, 0, 0"
                HeightRequest="650">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0"/>
            </Border.StrokeShape>

            <ScrollView>
                <StackLayout Padding="30" Spacing="20">
                    <Label Text="Create PUV Account" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"
                           TextColor="#333"/>

                    <!-- Username -->
                    <Entry Placeholder="Username"
                           x:Name="UsernameEntry"
                           TextColor="#333"
                           PlaceholderColor="#999"
                           FontSize="18"/>
                    <Label x:Name="UsernameErrorLabel"
                           TextColor="Red"
                           FontSize="14"
                           IsVisible="False"/>

                    <!-- Plate Number -->
                    <Entry Placeholder="Plate Number"
                           x:Name="PlateNumberEntry"
                           TextColor="#333"
                           PlaceholderColor="#999"
                           FontSize="18"/>
                    <Label x:Name="PlateNumberErrorLabel"
                           TextColor="Red"
                           FontSize="14"
                           IsVisible="False"/>

                    <!-- Email -->
                    <Entry Placeholder="Email" 
                           x:Name="EmailEntry" 
                           Keyboard="Email"
                           TextColor="#333"
                           PlaceholderColor="#999"
                           FontSize="18"/>
                    <Label x:Name="EmailErrorLabel"
                           TextColor="Red"
                           FontSize="14"
                           IsVisible="False"/>

                    <!-- Password -->
                    <Entry Placeholder="Password" 
                           x:Name="PasswordEntry" 
                           IsPassword="True"
                           TextColor="#333"
                           PlaceholderColor="#999"
                           FontSize="18"/>
                    <Label x:Name="PasswordErrorLabel"
                           TextColor="Red"
                           FontSize="14"
                           IsVisible="False"/>

                    <!-- Show Password Toggle -->
                    <StackLayout Orientation="Horizontal" HorizontalOptions="End">
                        <CheckBox x:Name="ShowPasswordCheckBox" CheckedChanged="OnShowPasswordCheckedChanged"/>
                        <Label Text="Show Password" VerticalOptions="Center"/>
                    </StackLayout>

                    <!-- Activity Indicator -->
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       Color="#efbb6b"
                                       HorizontalOptions="Center"/>

                    <!-- Create Account Button -->
                    <Button Text="Create Account"
                            Clicked="OnCreatePUVClicked"
                            BackgroundColor="#efbb6b"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="50"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="FillAndExpand"/>

                    <!-- Footer -->
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,20,0,0">
                        <Button Text="Back to Settings"
                                Clicked="OnBackClicked"
                                TextColor="#efbb6b"
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontSize="14"/>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
